<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NymBroker.Endpoint.MySql</PackageId>
    <PackageDescription>MySQL / MariaDB queue-table transport for NymBroker: leased rows with SKIP LOCKED, so several instances can share one queue, plus retries, failed rows and atomic batch posts.</PackageDescription>
    <PackageTags>$(PackageTags);mysql;mariadb;queue-table</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NymBroker.Core\NymBroker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NymBroker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
