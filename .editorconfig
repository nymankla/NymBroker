root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Enforced in the packable projects (EnforceCodeStyleInBuild, see Directory.Build.props).
dotnet_diagnostic.IDE0005.severity = warning  # unused using
dotnet_diagnostic.IDE0051.severity = warning  # unused private member
dotnet_diagnostic.IDE0052.severity = warning  # private member never read
dotnet_diagnostic.IDE0059.severity = warning  # value assigned but never used
dotnet_diagnostic.IDE0060.severity = warning  # unused parameter

# Source-generated logging is used where code runs per message; elsewhere it would only add declarations.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# Public API names that are stable and deliberate: changing them breaks clients for no behaviour gain.
dotnet_diagnostic.CA1068.severity = none  # CancellationToken before optional parameters on Post*
dotnet_diagnostic.CA1711.severity = none  # AggregatorImpl, SplitterImpl
dotnet_diagnostic.CA1716.severity = none  # To, When, And, Or on the route builders (Visual Basic keywords)
dotnet_diagnostic.CA1725.severity = none  # HealthCheckAsync's parameter name

# A SemaphoreSlim or a CancellationTokenSource without a timer holds nothing that needs disposing here.
dotnet_diagnostic.CA1001.severity = none

# Interfaces are the clearer signature on these private helpers; the gain is negligible off the hot path.
dotnet_diagnostic.CA1859.severity = none
