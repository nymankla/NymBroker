<Project>
  <!--
    Single source of truth for NuGet package version.
    Update with:  .\pack.ps1 -Version 1.2.3
    Or bump with: .\pack.ps1 -BumpPatch | -BumpMinor | -BumpMajor
  -->
  <PropertyGroup>
    <Version>0.23.0</Version>
    <Authors>nymankla@gmail.com</Authors>
    <RepositoryUrl>https://github.com/nymankla/NymBroker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nymankla/NymBroker</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>NymBroker;messaging;message-processing;message-queue;message-broker;integration;eip;enterprise-integration-patterns;pubsub;routing;dead-letter</PackageTags>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NymBroker.Core' Or $(MSBuildProjectName.StartsWith('NymBroker.Endpoint.')) Or $(MSBuildProjectName.StartsWith('NymBroker.Idempotency.')) Or $(MSBuildProjectName.StartsWith('NymBroker.Scheduling.')) Or $(MSBuildProjectName.StartsWith('NymBroker.Outbox.'))">
    <IsNymBrokerPackage>true</IsNymBrokerPackage>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsNymBrokerPackage)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IsNymBrokerPackage)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A comment on every public member is not required; a wrong cref or malformed comment still warns. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0018;RS0024;RS0025;RS0036</WarningsAsErrors>
  </PropertyGroup>
</Project>