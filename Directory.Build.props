<Project>
  <!--
    Single source of truth for NuGet package version.
    Update with:  .\pack.ps1 -Version 1.2.3
    Or bump with: .\pack.ps1 -BumpPatch | -BumpMinor | -BumpMajor
  -->
  <PropertyGroup>
    <Version>0.9.3</Version>
    <Authors>nymankla@gmail.com</Authors>
    <RepositoryUrl>https://github.com/nymankla/NymBroker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nymankla/NymBroker</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>NymBroker;messaging;message-processing;integration</PackageTags>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NymBroker.Core' Or '$(MSBuildProjectName)' == 'NymBroker.Endpoint.AzureServiceBus' Or '$(MSBuildProjectName)' == 'NymBroker.Endpoint.Postgres' Or '$(MSBuildProjectName)' == 'NymBroker.Endpoint.RabbitMq' Or '$(MSBuildProjectName)' == 'NymBroker.Endpoint.SqlServer' Or '$(MSBuildProjectName)' == 'NymBroker.Endpoint.Sqlite' Or '$(MSBuildProjectName)' == 'NymBroker.Idempotency.Postgres' Or '$(MSBuildProjectName)' == 'NymBroker.Idempotency.SqlServer' Or '$(MSBuildProjectName)' == 'NymBroker.Idempotency.Sqlite'">
    <IsNymBrokerPackage>true</IsNymBrokerPackage>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsNymBrokerPackage)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IsNymBrokerPackage)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0018;RS0024;RS0025;RS0036</WarningsAsErrors>
  </PropertyGroup>
</Project>