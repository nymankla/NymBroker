<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NymBroker.Endpoint.SqlServer</PackageId>
    <PackageDescription>SQL Server queue-table transport for NymBroker: leased rows with READPAST, so several instances can share one queue, plus retries, failed rows and atomic batch posts.</PackageDescription>
    <PackageTags>$(PackageTags);sqlserver;mssql;queue-table</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NymBroker.Core\NymBroker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Security pin: SqlClient 7.1.1 pulls in Pkcs 9.0.18 (CVE-2026-84008, CVE-2026-70162). Remove once SqlClient references a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NymBroker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
