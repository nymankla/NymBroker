<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NymBroker</PackageId>
    <PackageDescription>Message routing, pub/sub, consumers, splitter and aggregator, idempotent receiver, scheduling and dead-letter handling for .NET, following Enterprise Integration Patterns. Includes in-memory and file endpoints; transports ship as NymBroker.Endpoint.* packages.</PackageDescription>
    <PackageTags>$(PackageTags);servicebus;event-driven;splitter;aggregator;idempotency;opentelemetry</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NymBroker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
