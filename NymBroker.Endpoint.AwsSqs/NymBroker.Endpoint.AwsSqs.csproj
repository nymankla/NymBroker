<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NymBroker.Endpoint.AwsSqs</PackageId>
    <PackageDescription>Amazon SQS endpoint add-on for NymBroker: standard and FIFO queues, long polling, batched settlement.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NymBroker.Core\NymBroker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.16" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NymBroker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
